{
  "manifest_version": 3,
  "name": "PubRescue — Publisher (.pub) to PDF",
  "short_name": "PubRescue",
  "version": "1.1.0",
  "description": "Open and convert Microsoft Publisher (.pub) files to PDF without Publisher. Works offline, files never leave your computer.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Convert Publisher files to PDF", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" } },
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
