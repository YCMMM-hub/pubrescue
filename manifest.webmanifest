{
  "name": "PubRescue — Publisher to PDF",
  "short_name": "PubRescue",
  "description": "Convert Microsoft Publisher (.pub) files to PDF locally, without Publisher.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f8fa",
  "theme_color": "#1f5f8b",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    { "action": "./index.html", "accept": { "application/x-mspublisher": [".pub"], "application/vnd.ms-publisher": [".pub"] } }
  ]
}
